OPENROUTER_API_KEY=your-key-here
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Live AWS IAM (optional, disabled by default) ---
# Set USE_LIVE_AWS=true and provide read-only IAM credentials to have the
# agent trace your REAL AWS account's IAM roles instead of the mock dataset.
# Recommended: a dedicated IAM user with only read permissions
# (iam:ListRoles, iam:GetRole, iam:ListAttachedRolePolicies, iam:GetPolicy,
# iam:GetPolicyVersion) — do not use root or write-capable credentials.
# USE_LIVE_AWS=true
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
