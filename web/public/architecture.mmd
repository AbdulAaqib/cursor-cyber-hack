graph TD
    User["User / Browser"]

    subgraph Vercel["Vercel — Next.js App"]
        UI["Console UI (/console)"]
        Investigate["/api/investigate (SSE)"]
        RemediateAWS["/api/remediate/aws"]
        RemediateGH["/api/remediate/github"]
        StatusGH["/api/status/github"]
        DemoRepo["Bundled demo-repo/ source files"]
    end

    OpenRouter["OpenRouter LLM (gpt-4o-mini)"]

    subgraph AWSAcct["AWS Account"]
        IAMReadOnly["IAM read-only credential"]
        IAMWrite["IAM scoped write credential"]
        DemoRoles["Real IAM role chain: lambda-log-processor to admin-deploy-role"]
    end

    subgraph GH["GitHub"]
        Repo["cursor-cyber-hack repo"]
        Actions["GitHub Actions: exposure-scan.yml"]
