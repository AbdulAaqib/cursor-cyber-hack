OPENROUTER_API_KEY=your-key-here
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- Live AWS IAM (optional, disabled by default) ---
# Set USE_LIVE_AWS=true and provide read-only IAM credentials to have the
# agent trace your REAL AWS account's IAM roles instead of the mock dataset.
# Recommended: a dedicated IAM user with only read permissions
# (iam:ListRoles, iam:GetRole, iam:ListAttachedRolePolicies, iam:GetPolicy,
# iam:GetPolicyVersion) — do not use root or write-capable credentials.
# USE_LIVE_AWS=true
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1

# --- Remediation (optional, requires USE_LIVE_AWS=true) ---
# A SEPARATE, narrowly-scoped write credential — only used by the
# human-approved "Approve & Apply" flow, never by the investigation agent
# above. Scope it via an IAM policy Condition to exactly the one role +
# one policy ARN your remediation action touches (see README "AWS
# integration" section) — do not grant broad iam:*RolePolicy access.
# AWS_REMEDIATION_ACCESS_KEY_ID=
# AWS_REMEDIATION_SECRET_ACCESS_KEY=

# GitHub token (repo scope) + "owner/repo" — used only by the human-approved
# "open a fix PR" remediation action, via the GitHub REST API directly (no
# git/gh CLI dependency, works the same locally and on Vercel).
# GITHUB_TOKEN=
# GITHUB_REPO=your-username/your-repo
